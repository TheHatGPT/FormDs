# ============================================================================
# SECURITY & DISCORD CONFIGURATION
# ============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Your numeric 18/19-digit Discord User ID (strictly locks the bot to your DMs)
OWNER_DISCORD_ID=123456789012345678

# ============================================================================
# SEC EDGAR & SEDAR+ CONFIGURATION
# ============================================================================
# SEC EDGAR requires format: "AppName ContactEmail@domain.com"
SEC_USER_AGENT="FormDScoutBot your_email@example.com"
DEFAULT_POLL_INTERVAL_MINUTES=15
SEDAR_ENABLED=true
SEDAR_MIN_COOLDOWN_MINUTES=15
CAD_TO_USD_RATE=0.72

# ============================================================================
# AI, SEARCH & QC APIS
# ============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

EXA_API_KEY=your_exa_api_key_here

TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-latest
# Minimum TypeSafe `noul` probability (0.0 to 1.0) required to accept a match
TYPESAFE_CONFIDENCE_THRESHOLD=0.70

# ============================================================================
# CONTACT ENRICHMENT APIS (APIFY & APOLLO.IO READY)
# ============================================================================
# Options: "apify" (default), "apollo", or "both"
ENRICHER_PROVIDER=apify
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_LINKEDIN_EMAIL_ACTOR=vulnv/linkedin-email-finder
APIFY_EMAIL_VERIFIER_ACTOR=michael.g/email-verifier-validator

# Ready for future v2 activation
APOLLO_API_KEY=
